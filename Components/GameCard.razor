@using KafeTerningkast.Models

<div class="card h-100 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">@Game.Name</h5>
        <p class="card-text text-muted mb-1">@Game.Category</p>
        <p class="card-text mb-1">
            @Game.MinPlayers-@Game.MaxPlayers spillere | @Game.PlayTimeMinutes min
        </p>
        <p class="card-text">
            Terningkast: @Game.Rating
        </p>
        <p class="card-text small">@Game.Description</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public BoardGame Game { get; set; } = default!;
}
