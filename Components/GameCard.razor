@using KafeTerningkast.Models

<div class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">
            <a href="@($"/games/{Game.Id}")" class="text-decoration-none">@Game.Name</a>
        </h5>
        <p class="card-text text-muted mb-1">@Game.Category</p>
        <p class="card-text mb-1">
            @Game.MinPlayers-@Game.MaxPlayers spillere | @Game.PlayTimeMinutes min
        </p>
        <p class="card-text mb-2"> Terningkast:</p>
        <DiceRating Value="@Game.Rating" ReadOnly="true" />

        <p class="card-text small mt-2 flex-grow-1">@Game.Description</p>
        
        <div class="d-flex gap-2 mt-auto">
            <a class="btn btn-outline-primary btn-sm" href="@($"/games/{Game.Id}")">Se mer</a>
            <button type="button" class="btn btn-success btn-sm" @onclick="OnAddClicked">
                Legg til spille listen
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public BoardGame Game { get; set; } = default!;

    [Parameter]
    public EventCallback<BoardGame> OnAddToGameNight { get; set; }

    private async Task OnAddClicked()
    {
        await OnAddToGameNight.InvokeAsync(Game);
    }
}
