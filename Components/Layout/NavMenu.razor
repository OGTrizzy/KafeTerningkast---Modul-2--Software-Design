@using KafeTerningkast.Services
@inject GameNightState GameNight
@implements IDisposable
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">KafeTerningkast</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="games">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Spillbua
            </NavLink>
        </div>
    
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="game-night">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Spillekveld
                @if (GameNight.Count > 0)
                {
                    <span class="badge bg-primary ms-1">@GameNight.Count</span>
                }
            </NavLink>
        </div>
    
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/games">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Bak disken
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        GameNight.Changed += OnGameNightChanged;
    }

    private void OnGameNightChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        GameNight.Changed -= OnGameNightChanged;
    }
}