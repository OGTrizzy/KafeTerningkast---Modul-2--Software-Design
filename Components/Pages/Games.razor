@page "/games"
@rendermode InteractiveServer
@using KafeTerningkast.Models
@using KafeTerningkast.Services
@inject GameApiClient Api
@inject GameNightState GameNight
@implements IDisposable

<PageTitle>Spillbua - Kafe Terningkast</PageTitle>

<h1>Spillbua</h1>
<p class="text-muted">Finn ditt neste brettspill!</p>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success">@statusMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label class="form-label" for="search">Søk etter spill</label>
        <input id="search" 
               class="form-control" 
               placeholder="Søk etter spill..." 
               @bind="searchText"
               @bind:event="oninput"/>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="players">Antall spillere</label>
        <input id="players"
               type="number"
               class="form-control"
               min="1"
               @bind="playerFilter"
               @bind:event="oninput"/>
        <div class="form-text"> la stå tomt for å vise alle spill</div>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="button" class="btn btn-primary w-100" @onclick="RollDice">kast terningen</button>
    </div>
</div>

<p class="fw-semibold">Antall spill funnet: @FilteredGames.Count()</p>

@if (isLoading)
{
    <p> laster spill</p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (FilteredGames.Count == 0)
{
    <div class="alert alert-info">
        ingen spill funnet
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var game in FilteredGames)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="@(highlightedId == game.Id ? "border border-3 border-primary rounded" : "")">
                    <GameCard Game="@game"
                              IsSelected="GameNight.Contains(game.Id)"
                              OnAddToGameNight="HandleAddToGameNight"/>
                </div>
            </div>
        }
    </div>
}
@code {
    private string searchText ="";
    private string playerFilter = "";
    private int? highlightedId;
    private string? statusMessage;
    private bool isLoading = true;
    private string? errorMessage;
    private List<BoardGame> allGames = [];

    protected override async Task OnInitializedAsync()
    {
        GameNight.Changed += OnGameNightChanged;
        await LoadGamesAsync();
    }

    private async Task LoadGamesAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            allGames = await Api.GetAllAsync();
        }
        catch
        {
            errorMessage = "feilet med å hente spill, prøv igjen snart";
            allGames = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnGameNightChanged() => InvokeAsync(StateHasChanged);

    private void HandleAddToGameNight(BoardGame game)
    {
        if (GameNight.Add(game))
            statusMessage = $"{game.Name} er lagt til spillelisten!";
        else
            statusMessage = $"{game.Name} er allerede i spillelisten!";
    }

    public void Dispose()
    {
        GameNight.Changed -= OnGameNightChanged;
    }

    private IReadOnlyList<BoardGame> FilteredGames => GetFilteredGames();

    private List<BoardGame> GetFilteredGames()
    {
        IEnumerable<BoardGame> query = allGames;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            query = query.Where(g => g.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));
        }

        if (int.TryParse(playerFilter, out int players) && players > 0)
        {
            query = query.Where(g => g.MinPlayers <= players && g.MaxPlayers >= players);
        }

        return query.ToList();
    }

    private void RollDice()
    {
        var matches = GetFilteredGames();
        if (matches.Count == 0)
        {
            highlightedId = null;
            return;
        }

        var index = Random.Shared.Next(matches.Count);
        highlightedId = matches[index].Id;
    }
}
