@page "/games/{Id:int}"
@rendermode InteractiveServer
@using KafeTerningkast.Models
@using KafeTerningkast.Services
@inject GameApiClient Api
@inject NavigationManager Navigation
@inject GameNightState GameNight
@implements IDisposable

<PageTitle>@(game?.Name ?? "Spill") - Kafe Terningkast</PageTitle>

@if (isLoading)
{
    <p>laster spill</p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
    <a href="/games" class="btn btn-link">Gå tilbake til spillbua</a>
}
else if (game is null)
{
    <div class="alert alert-warning">
        Fant ikke spillet med id @Id
        <a href="/games" class="btn btn-link">Gå tilbake til spillbua</a>
    </div>
}
else
{
    <h1>@game.Name</h1>
    <p class="text-muted">@game.Category</p>
    
    <dl class="row">
        <dt class="col-sm-3">Spillere</dt>
        <dd class="col-sm-9">@game.MinPlayers - @game.MaxPlayers</dd>
        
        <dt class="col-sm-3">Spilletid</dt>
        <dd class="col-sm-9">@game.PlayTimeMinutes minutter</dd>
        
        <dt class="col-sm-3">Beskrivelse</dt>
        <dd class="col-sm-9">@game.Description</dd>
        
        <dt class="col-sm-3">Terningkast</dt>
        <dd class="col-sm-9">
            <DiceRating @bind-Value="game.Rating" ReadOnly="false" />
        </dd>
    </dl>

    <div class="d-flex gap-2">
        @if (GameNight.Contains(game.Id))
        {
            <button type="button" class="btn btn-secondary" disabled>allerede valgt</button>
        }
        else
        {
        <button type="button" class="btn btn-success" @onclick="AddToGameNight">
            Legg til
        </button>
        }
        <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">
            Tilbake
        </button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success mt-3">
            @statusMessage
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private BoardGame? game;
    private string? statusMessage;
    private string? errorMessage;
    private bool isLoading = true;

    protected override void OnInitialized()
    {
        GameNight.Changed += OnGameNightChanged;
    }

    private async Task LoadGameAsync()
    {
        isLoading = true;
        errorMessage = null;
        statusMessage = null;
        game = null;

        try
        {
            game = await Api.GetByIdAsync(Id);
        }
        catch
        {
            errorMessage = "kunne ikke hente spill";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnGameNightChanged() => InvokeAsync(StateHasChanged);

    private void AddToGameNight()
    {
        if (game is null) return;

        if(GameNight.Add(game))
            statusMessage = $"{game.Name} er lagt til.";
        else
            statusMessage = $"{game.Name} er allerede lagt til";
    }

    public void Dispose()
    {
        GameNight.Changed -= OnGameNightChanged;
    }

    protected override async Task OnParametersSetAsync()
    {   
        //laster inn på nytt hvis Id endres til annen spill og når siden åpner
        await LoadGameAsync();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/games");
    }
    
}
