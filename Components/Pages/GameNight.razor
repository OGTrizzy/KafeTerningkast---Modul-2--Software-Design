@page "/game-night"
@rendermode InteractiveServer
@using KafeTerningkast.Services
@inject GameNightState NightState
@implements IDisposable

<PageTitle>Spillekveld</PageTitle>

<h1>Spillekveld</h1>

<p class="fw-semibold">
    Antall spill: @NightState.Count - Samlet spilletid: @NightState.TotalPlayTimeMinutes min
</p>

@if (NightState.Count == 0)
{
    <div class="alert alert-info">
        ingen spill valgt
    </div>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var game in NightState.SelectedGames)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@game.Name</strong>
                    <span class="text-muted"> . @game.PlayTimeMinutes min</span>
                </div>
                <button type="button"
                        class="btn btn-outline-danger btn-sm"
                        @onclick="() => Remove(game.Id)">
                    fjern
                </button>
            </li>
        }
    </ul>
}

@code {
    protected override void OnInitialized()
    {
        NightState.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Remove(int gameId) => NightState.Remove(gameId);

    public void Dispose()
    {
        NightState.Changed -= OnChanged;
    }
}
